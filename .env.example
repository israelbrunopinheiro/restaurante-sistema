# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Settings → API). A chave "publishable" é pública por design; quem protege
# os dados são as regras de acesso (RLS) do banco.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
